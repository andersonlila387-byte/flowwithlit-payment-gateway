RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Always use HTTPS on the live site (local development on localhost is left alone).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never serve server configuration, stored mail, or database scripts publicly.
RewriteRule ^(?:storage|config|database|services|scratch|tests|cron|docs|vendor|emails)(?:/|$) - [F,L,NC]
RewriteRule (^|/)\.(?:env|git)(?:[./]|$) - [F,L,NC]
# Deployment bundles, notes and dependency manifests (could reveal source code or setup details).
RewriteRule \.(?:zip|sql|md|log|bak|lock)$ - [F,L,NC]
RewriteRule (^|/)composer\.json$ - [F,L,NC]

# Browser security headers for every page and API response.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# 0. Set DirectoryIndex to prioritize index.php
DirectoryIndex index.php index.html

# Hosted customer checkout uses an opaque token. The token is resolved server-side;
# amount, customer data, and merchant details are never placed in the URL.
RewriteRule ^checkout/([A-Za-z0-9_-]{16,80})/?$ checkout.php?token=$1 [QSA,L,NC]
RewriteRule ^pay/([A-Za-z0-9_-]{16,80})/?$ checkout.php?token=$1 [QSA,L,NC]

# 1. Map extensionless URLs to .php files if they exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 2. Fallback to .html files if .php does not exist
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 3. API endpoints must keep their .php URL. Redirecting a POST would turn it into a GET.
RewriteRule ^api/ - [L]

# 3b. Never show "index" in the address bar: /app/index, /app/index.php -> /app/ (and /index -> /).
# Checks the original request line, so internal rewrites to index.php are unaffected.
RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index(?:\.php|\.html)?(?:[\s?]) [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Redirect explicit .php and .html URLs to extensionless URLs (e.g., /about.php -> /about)
RewriteCond %{THE_REQUEST} \s/+(.+)\.(php|html)[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 5. Prevent Directory Browsing
Options -Indexes

# 6. UTF-8 Encoding
AddDefaultCharset UTF-8
