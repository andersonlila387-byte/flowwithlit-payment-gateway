FLOW_DB_HOST=127.0.0.1
FLOW_DB_PORT=3306
FLOW_DB_NAME=flowwithlit_db
FLOW_DB_USER=flowwithlit_app
FLOW_DB_PASSWORD=replace_with_a_strong_password
# Must be outside the public document root. The installer creates this automatically.
FLOW_PRIVATE_STORAGE=/var/lib/flowwithlit-private
FLOW_ALLOWED_ORIGINS=https://flowwithlit.com,https://www.flowwithlit.com,https://admin.flowwithlit.com
FLOW_APP_URL=https://flowwithlit.com
FLOW_ADMIN_URL=https://admin.flowwithlit.com
# Use the API host when the admin subdomain has /admin as its document root.
FLOW_ADMIN_API_URL=https://api.flowwithlit.com/admin
FLOW_CHECKOUT_URL=https://checkout.flowwithlit.com
FLOW_API_URL=https://api.flowwithlit.com
# Set checkout bank-transfer charges only after commercial approval. Values are in percent and NGN.
FLOW_CHECKOUT_BANK_TRANSFER_FEE_PERCENT=0
FLOW_CHECKOUT_BANK_TRANSFER_FEE_FIXED_NGN=0
FLOW_MAIL_HOST=smtp.example.com
FLOW_MAIL_PORT=587
FLOW_MAIL_USERNAME=mailer@example.com
FLOW_MAIL_PASSWORD=replace_with_smtp_password
FLOW_MAIL_ENCRYPTION=tls
FLOW_MAIL_FROM_ADDRESS=no-reply@your-domain.com
FLOW_MAIL_FROM_NAME=Flowwithlit
# OnePipe credentials are server-side only. Obtain these after partner approval.
ONEPIPE_API_URL=https://api.onepipe.io
ONEPIPE_API_KEY=replace_with_onepipe_api_key
ONEPIPE_API_SECRET=replace_with_onepipe_api_secret
ONEPIPE_AUTH_PROVIDER=replace_with_approved_provider
ONEPIPE_MOCK_MODE=Live
ONEPIPE_WEBHOOK_SECRET=replace_with_webhook_secret
ONEPIPE_BANKS_URL=
FLOW_RATE_PROVIDER_URL=
# Go payment service (server-side only). Set the WebSocket URL only if it is publicly reachable by checkout browsers.
FLOW_GO_ADDR=:8081
FLOW_GO_BASE_URL=http://127.0.0.1:8081
FLOW_GO_SERVICE_SECRET=replace_with_a_long_random_internal_secret
FLOW_GO_WS_URL=ws://127.0.0.1:8081/ws/checkout
# Temporary bootstrap values are for local sandbox workers only; production credentials belong in the encrypted admin integration record.
BREET_BASE_URL=https://api.breet.io/v1
BREET_ENV=sandbox
BREET_APP_ID=
BREET_APP_SECRET=
BREET_WEBHOOK_SECRET=
BREET_ALLOWED_IPS=46.101.201.155,46.101.225.109,46.101.225.97,46.101.225.251,159.89.20.62
